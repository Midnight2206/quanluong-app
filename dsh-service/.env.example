DSH_SERVICE_TOKEN=change-me
DSH_RUNTIME=sdk
DSH_PROFILE=sdk-minimal
DSH_HOME=/var/lib/dsh
DSH_MODEL=google/gemini-3.8-flash
DSH_SPLIT_PROFILES=0
OPENROUTER_API_KEY=
MENU_AI_API_KEY=
MENU_AI_BASE_URL=https://openrouter.ai/api/v1
LEDGER_TOOL_BACKEND_URL=http://127.0.0.1:3000
PORT=3090
# Set any of these to 0 to unmount that plugin.
DSH_PLUGIN_SKILL_LOOP=1
DSH_PLUGIN_MEMORY=1
DSH_PLUGIN_SUBAGENTS=1
DSH_PLUGIN_SCHEDULE=1
DSH_PLUGIN_SANDBOX=1
DSH_SCHEDULE_INTERVAL_MS=60000
DSH_SUBAGENT_MAX=3
DSH_SANDBOX_STRICT=1
