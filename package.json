{
  "name": "quanluong-monorepo",
  "private": true,
  "dependencies": {
    "html-to-image": "^1.11.13"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@quanluong/web",
    "dev:superadmin": "npm run dev --workspace=@quanluong/superadmin",
    "dev:supplier": "npm run dev --workspace=@quanluong/supplier",
    "build:web": "npm run build --workspace=@quanluong/web",
    "build:superadmin": "npm run build --workspace=@quanluong/superadmin",
    "build:supplier": "npm run build --workspace=@quanluong/supplier",
    "audit:unified-scroll": "node scripts/audit-unified-page-scroll.mjs",
    "test:mobile-shell": "node packages/shared/src/mobile-shell.check.mjs",
    "test:mobile-visual": "node tests/mobile-visual/run.mjs",
    "docker:prod": "docker compose -f docker-compose.yml -f docker-compose.prod-ui.yml --env-file quanluong-app-be/.env.docker up --build",
    "docker:dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml --env-file quanluong-app-be/.env.docker up --build"
  },
  "devDependencies": {
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0"
  }
}
